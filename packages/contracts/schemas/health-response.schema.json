{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "degraded"
      ]
    },
    "service": {
      "type": "string"
    },
    "redpanda": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected"
      ]
    },
    "postgres": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected"
      ]
    },
    "redis": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected"
      ]
    }
  },
  "required": [
    "status",
    "service"
  ],
  "additionalProperties": false
}
