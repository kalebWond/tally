{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "codes": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9]{1,16}$"
      }
    },
    "ratePerSec": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20000
    },
    "invalidCodeRatio": {
      "default": 0,
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "duplicateSenderRatio": {
      "default": 0,
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "contestId",
    "codes",
    "ratePerSec"
  ]
}
