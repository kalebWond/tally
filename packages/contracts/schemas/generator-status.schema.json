{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "running": {
      "type": "boolean"
    },
    "contestId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "baseRate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "currentRate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "burstEndsAt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "startedAt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "sentTotal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "accepted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rejected": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "failed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "invalidSent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "duplicateSent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "latencyMs": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "p50": {
              "type": "number"
            },
            "p95": {
              "type": "number"
            },
            "p99": {
              "type": "number"
            }
          },
          "required": [
            "p50",
            "p95",
            "p99"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "running",
    "contestId",
    "baseRate",
    "currentRate",
    "burstEndsAt",
    "startedAt",
    "sentTotal",
    "accepted",
    "rejected",
    "failed",
    "invalidSent",
    "duplicateSent",
    "latencyMs"
  ],
  "additionalProperties": false
}
