{
  "name": "@tally/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env src/bin/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/bin/seed.ts",
    "build": "tsup",
    "typecheck": "tsc -p .",
    "contests": "tsx --env-file-if-exists=../../.env src/bin/contests.ts"
  },
  "dependencies": {
    "@tally/contracts": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
