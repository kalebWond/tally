# Copy to .env for host-run services (pnpm dev). Compose reads this too.
# Containers in the `app` profile get in-network hosts from compose.yaml instead.

LOG_LEVEL=info

# Infrastructure, as seen from the host
KAFKA_BROKERS=localhost:19092
# Partitions for votes.raw and votes.dead (F35). Raising it adds partitions; they can't be removed.
TOPIC_PARTITIONS=24

# Replicas in the compose `app` profile (F36, F37). Ingest replicas sit behind nginx on port 4000;
# consumer replicas split the partitions. On a 4-core laptop the whole pipeline tops out near
# 4,700 votes/s however these are set (load-results/).
INGEST_REPLICAS=1
CONSUMER_REPLICAS=1

# Two-device mode (F38): the generator runs on another machine (`pnpm generator:exe` builds it for
# Windows). Uncomment both to run no local generator and reach that machine's instead.
# COMPOSE_FILE=compose.yaml:compose.two-device.yaml
# GENERATOR_HOST=192.168.1.4
DATABASE_URL=postgres://tally:tally@localhost:5432/tally
REDIS_URL=redis://localhost:6379

# Web: gateway address as the browser sees it. Read per request, never baked into the build.
GATEWAY_PUBLIC_URL=ws://localhost:4001

# Web: shared password for the operator pages (/control, admin). At least 8 characters; when
# unset, nobody can sign in. Never commit a real one.
ADMIN_PASSWORD=change-me-admin-password

# Web: the generator's control API, called server-side only (containers use http://generator:4002).
GENERATOR_URL=http://localhost:4002

# Analytics (F20): ClickHouse, as seen from the host. The container bootstraps these credentials.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=tally
CLICKHOUSE_PASSWORD=tally
CLICKHOUSE_DB=tally

# Grafana (F23): admin password for editing dashboards; anyone can view at :3001.
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Postgres container bootstrap
POSTGRES_USER=tally
POSTGRES_PASSWORD=tally
POSTGRES_DB=tally

# Ingest: HMAC key for hashing voter identifiers (min 16 chars). Never commit a real one.
# Generate with: openssl rand -hex 32
VOTER_HASH_SALT=change-me-to-a-random-32-byte-hex

# Generator: where it sends votes (host `go run`; containers use http://ingest:4000).
INGEST_URL=http://localhost:4000
